# Generate with: openssl rand -base64 32
AUTH_SECRET=replace_with_a_random_32_byte_secret

# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
AUTH_GOOGLE_ID=replace_with_google_oauth_client_id
AUTH_GOOGLE_SECRET=replace_with_google_oauth_client_secret

# The only Google account allowed to access the workspace
AUTH_OWNER_EMAIL=owner@example.com

# Local development URL. Replace with the deployed HTTPS origin in production.
AUTH_URL=http://localhost:3000
